<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri 打包时会把这个文件合并进 .app 的 Info.plist。

  Finder 的文件夹右键菜单没有稳定的「打开方式」入口，必须声明 NSServices
  并在应用启动时注册 servicesProvider。这里同时保留文件夹 document type，
  供拖到 Dock 图标和 Finder 的“用应用打开”类入口使用。

  NSServices → shell_integration/macos.rs 的 addToCodeShelf:userData:error:
  CFBundleDocumentTypes → lib.rs 的 RunEvent::Opened
-->
<plist version="1.0">
<dict>
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>添加到 CodeShelf</string>
      </dict>
      <key>NSMessage</key>
      <string>addToCodeShelf</string>
      <key>NSPortName</key>
      <string>CodeShelf</string>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.folder</string>
      </array>
      <key>NSRequiredContext</key>
      <dict/>
      <key>NSServiceDescription</key>
      <string>将选中的文件夹添加到 CodeShelf 代码书架</string>
      <key>NSTimeout</key>
      <string>10000</string>
    </dict>
  </array>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Folder</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.folder</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
