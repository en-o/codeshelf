# 默认忽略的文件
.DS_Store
/shelf/
/workspace.xml
# 基于编辑器的 HTTP 客户端请求
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
/.idea/codeshelf.iml
/.idea/misc.xml
/.idea/modules.xml
/.idea/git_toolbox_prj.xml
/.claude/settings.local.json
/node_modules/
# 不再忽略 package-lock.json，确保 CI 依赖版本一致
# /package-lock.json
/dist/
/.idea/workspace.xml

CodeShelf-Portable-*
/scripts/extracted_data/

.idea
# sidecar 编译产物：按目录忽略，不要再逐个文件枚举 ——
# 枚举法下每新增一个源文件，它的 .js 都会漏出来变成待提交项。
/src-node/resume-agent/dist/

# Rust 构建产物（target 由 src-tauri/.gitignore 管，target-win 是交叉编译用的）
/src-tauri/target-win/

# 本地密钥：.env 系列一律不进仓库，示例文件显式放行
.env
.env.*
!.env.example
# 忽略产物，但保留目录本身：tauri.conf.json 把 resources/sidecars/ 声明为资源，
# 目录不存在时 build.rs 直接报 "resource path doesn't exist"（CI 上 cargo check 必挂）。
/src-tauri/resources/sidecars/*
!/src-tauri/resources/sidecars/.gitkeep
