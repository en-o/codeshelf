{
  "name": "codeshelf",
  "version": "0.1.47",
  "private": true,
  "description": "代码书架 - 本地项目管理工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run resume-agent:build && npm run resume-agent:prepare-sidecar && tsc && vite build",
    "resume-agent:build": "tsc -p src-node/resume-agent/tsconfig.json",
    "resume-agent:prepare-sidecar": "node scripts/prepare-resume-agent-sidecar.mjs",
    "resume-agent:test": "npm run resume-agent:build && node --test src-node/resume-agent/dist/**/*.test.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:release": "bash scripts/verify-release.sh",
    "build:portable": "scripts\\build-portable.bat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/en-o/codeshelf.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/en-o/codeshelf/issues"
  },
  "homepage": "https://github.com/en-o/codeshelf#readme",
  "dependencies": {
    "@langchain/openai": "^1.4.1",
    "@tanstack/react-query": "^5.100.5",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tauri-apps/plugin-updater": "^2",
    "deepagents": "^1.10.2",
    "ignore": "^7.0.5",
    "lucide-react": "^0.563.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^25.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "esbuild": "^0.27.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
